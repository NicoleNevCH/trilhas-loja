# Copie este arquivo para ".env" (no cmd do Windows:  copy .env.example .env)
# e preencha os valores. O arquivo ".env" NÃO vai para o GitHub (está no .gitignore).

# --- Botmaker (envio SIMULADO: nada é enviado de verdade, mas o token é exigido) ---
# Token: Botmaker > Configurações > Integrações > API Botmaker > Gerar credenciais.
BOTMAKER_ACCESS_TOKEN=cole-seu-token-aqui
# ID do canal de WhatsApp (campo "id" de GET https://api.botmaker.com/v2.0/channels).
BOTMAKER_CHANNEL_ID=botproject-whatsapp-5511999999999
# Opcional: nome/ID da campanha. Vazio = campanha padrão.
BOTMAKER_CAMPAIGN=

# --- Cronograma ---
# Dia da semana dos envios: segunda, terça, quarta, quinta, sexta, sábado ou domingo.
DIA_SEMANA_ENVIO=segunda

# --- Opcionais (os padrões já funcionam) ---
# DDI usado quando o telefone do cliente não traz código do país.
# CODIGO_PAIS_PADRAO=55
# DB_PATH=data/loja.db
# RAW_DIR=data/raw
